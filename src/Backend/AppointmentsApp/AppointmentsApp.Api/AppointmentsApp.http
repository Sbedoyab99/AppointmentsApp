### Public Business Profile Endpoints (No Require Authentication)

# GET /api/public/business-profile - sin businessProfileId
# Debe retornar 400 Bad Request
GET {{AppointmentsApp_HostAddress}}/api/public/business-profile
Accept: application/json
x-api-key: {{ApiKey}}

###

# GET /api/public/business-profile?businessProfileId=... - sin autenticación
# Debe retornar 200 OK con datos del negocio
GET {{AppointmentsApp_HostAddress}}/api/public/business-profile?businessProfileId={{BusinessProfileId1}}
Accept: application/json
x-api-key: {{ApiKey}}

###

# GET /api/public/business-profile?businessProfileId=... - Perfil 2 (Consultorio Dr. García)
# Debe retornar 200 OK con datos del segundo negocio
GET {{AppointmentsApp_HostAddress}}/api/public/business-profile?businessProfileId={{BusinessProfileId2}}
Accept: application/json
x-api-key: {{ApiKey}}

###

# GET /api/public/business-profile?businessProfileId=... - con businessProfileId inválido
# Debe retornar 404 Not Found
GET {{AppointmentsApp_HostAddress}}/api/public/business-profile?businessProfileId=00000000-0000-0000-0000-000000000000
Accept: application/json
x-api-key: {{ApiKey}}

