### Public Auth Endpoints

# POST /api/public/auth/login - Test con Admin1
# Email: admin@business1.com, Password: Admin123456
# Debe retornar lista con 2 tenants (LosAmigos y DrGarcia)
POST {{AppointmentsApp_HostAddress}}/api/public/auth/login
Content-Type: application/json
x-api-key: {{ApiKey}}

{
  "email": "admin@business1.com",
  "password": "Admin123456"
}

###

# POST /api/public/auth/login - Test con Admin2
# Email: admin@business2.com, Password: Admin123456
# Debe retornar lista con 1 tenant (DrGarcia)
POST {{AppointmentsApp_HostAddress}}/api/public/auth/login
Content-Type: application/json
x-api-key: {{ApiKey}}

{
  "email": "admin@business2.com",
  "password": "Admin123456"
}

###

# POST /api/public/auth/select-tenant - Admin1 selecciona LosAmigos
POST {{AppointmentsApp_HostAddress}}/api/public/auth/select-tenant
Content-Type: application/json
x-api-key: {{ApiKey}}

{
  "userId": "{{AdminUserId1}}",
  "tenantId": "{{BusinessProfileId1}}"
}

###

# POST /api/public/auth/select-tenant - Admin1 selecciona DrGarcia
