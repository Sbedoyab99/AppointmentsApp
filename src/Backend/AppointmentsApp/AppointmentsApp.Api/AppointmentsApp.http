### Admin Endpoints (Require [Authorize(Policy = "AdminOnly")])

# GET /api/admin/health
# Verifica que solo usuarios con rol Admin pueden acceder
# Debe fallar sin JWT (401 Unauthorized)
GET {{AppointmentsApp_HostAddress}}/api/admin/health
Accept: application/json
x-api-key: {{ApiKey}}

###

# GET /api/admin/health with valid JWT
# Debe retornar 200 OK si el token tiene rol Admin
GET {{AppointmentsApp_HostAddress}}/api/admin/health
Authorization: Bearer {{AccessToken}}
Accept: application/json
x-api-key: {{ApiKey}}

###

### Business Profile Endpoints (Require [Authorize(Policy = "AdminOnly")])

# GET /api/admin/business-profile - sin JWT
# Debe retornar 401 Unauthorized
GET {{AppointmentsApp_HostAddress}}/api/admin/business-profile
Accept: application/json
x-api-key: {{ApiKey}}

###

# GET /api/admin/business-profile - con JWT válido
# Debe retornar 200 OK con datos del negocio
GET {{AppointmentsApp_HostAddress}}/api/admin/business-profile
Authorization: Bearer {{AccessToken}}
Accept: application/json
x-api-key: {{ApiKey}}

###

# PUT /api/admin/business-profile - actualizar con datos válidos
PUT {{AppointmentsApp_HostAddress}}/api/admin/business-profile
Authorization: Bearer {{AccessToken}}
Content-Type: application/json
Accept: application/json
x-api-key: {{ApiKey}}

{
  "name": "LosAmigos Barbería",
  "tradeName": "Los Amigos",
  "description": "Barbería con los mejores servicios de corte y afeitado",
  "phone": "+57 300 123 4567",
  "address": "Carrera 10 #5-30, Bogotá",
  "email": "contacto@losamigos.com",
  "timeZone": "America/Bogota"
}

###

